-static struct gl_context gl_ctx;
+/* The front end's context. One per thread, made the first time the thread
+compiles (a __thread pointer, not a __thread struct: gl_context is large),
+so that several threads can compile at once; two compiles sharing the one
+static context this replaces would corrupt each other's parse. */
+static __thread struct gl_context *gl_ctx;
+
+static struct gl_context *frontend_context()
+{
+	if (!gl_ctx)
+	{
+		gl_ctx = (struct gl_context*)calloc(1, sizeof(struct gl_context));
+		if (!gl_ctx)
+		{
+			fprintf(stderr, "the GLSL front end's context could not be allocated\n");
+			abort();
+		}
+		initialize_context(gl_ctx, API_OPENGL_CORE);
+	}
+	return gl_ctx;
+}
 
 void glsl_frontend_init()
 {
-	initialize_context(&gl_ctx, API_OPENGL_CORE);
+	frontend_context();
 }
 
 void glsl_frontend_exit()
 {
-	_mesa_glsl_release_types();
-	_mesa_glsl_release_builtin_functions();
+	/* Never, while the program lives: this used to release Mesa's global
+	type tables and built-in functions, so every DekoCompiler's destruction
+	made the next compile rebuild them (much of a compile's time), and two
+	compiles at once tore down each other's state. The tables are shared,
+	read-only after they are built, and guarded by their own locks. */
 }
 
