# Host functions only the Switch's guest imports, beside port/android/host_imports.list
# (defined in port/switch/host). tools/android_imports.py generates the stubs.

# the deko3d renderer (port/switch/guest/d3d8_dk.c, port/switch/host/host_dk.c)
host_dk_submit
host_dk_retired
host_dk_visibility
# the deko3d renderer's shader cache (port/switch/guest/dk_shaders.c,
# port/switch/host/host_dk_shaders.c). A 64-bit hash travels in one X
# register on both sides, and glsl/state_out are guest addresses
host_dk_shader_find
host_dk_shader_compile
host_dk_shader_known
