<?xml version="1.0" encoding="UTF-8"?>
<!-- The port's multiplayer screens, in the PC version's style (tools/port_settings.py) -->
<menus>
	<widget name="main_menu/news/news_screen" width="640" height="480" bitmap="bitmaps/gradient_big">
		<data input="port news update"/>
		<on event="created" run="port news init"/>
		<on event="b" run="port news close"/>
		<on event="back" run="port news close"/>
		<on event="x" run="port news close"/>
		<on event="up" run="port news up"/>
		<on event="stick_up" run="port news up"/>
		<on event="right_stick_up" run="port news up"/>
		<on event="down" run="port news down"/>
		<on event="stick_down" run="port news down"/>
		<on event="right_stick_down" run="port news down"/>
		<on event="left" run="port news page up"/>
		<on event="right" run="port news page down"/>
		<child widget="main_menu/news/news_panel" x="17" y="14"/>
		<child widget="main_menu/news/news_title" x="66" y="84"/>
		<child widget="main_menu/news/news_line" x="82" y="130"/>
		<child widget="main_menu/news/news_line" x="82" y="148"/>
		<child widget="main_menu/news/news_line" x="82" y="166"/>
		<child widget="main_menu/news/news_line" x="82" y="184"/>
		<child widget="main_menu/news/news_line" x="82" y="202"/>
		<child widget="main_menu/news/news_line" x="82" y="220"/>
		<child widget="main_menu/news/news_line" x="82" y="238"/>
		<child widget="main_menu/news/news_line" x="82" y="256"/>
		<child widget="main_menu/news/news_line" x="82" y="274"/>
		<child widget="main_menu/news/news_line" x="82" y="292"/>
		<child widget="main_menu/news/news_line" x="82" y="310"/>
		<child widget="main_menu/news/news_line" x="82" y="328"/>
		<child widget="main_menu/news/dpad_up_butn_news" x="230" y="378"/>
		<child widget="main_menu/news/news_scroll_text" x="264" y="371"/>
		<child widget="main_menu/news/dpad_down_butn_news" x="320" y="378"/>
		<child widget="main_menu/news/b_butn_news_back" x="366" y="371"/>
		<child widget="main_menu/news/news_back_text" x="366" y="371"/>
	</widget>
	<widget name="main_menu/news/news_panel" width="640" height="480" bitmap="bitmaps/controller_border">
	</widget>
	<widget name="main_menu/news/news_title" type="text" controller="1" width="507" height="30" font="ui\large_ui" color="#FF2896FF">
	</widget>
	<widget name="main_menu/news/news_line" type="text" controller="1" width="475" height="18" font="ui\small_ui" color="#FFFFFFFF" text_flags="no_focus_test">
	</widget>
	<widget name="main_menu/news/dpad_up_butn_news" width="16" height="16" bitmap="bitmaps/arrow_sm_up">
	</widget>
	<widget name="main_menu/news/dpad_down_butn_news" width="16" height="16" bitmap="bitmaps/arrow_sm_down">
	</widget>
	<widget name="main_menu/news/news_scroll_text" type="text" controller="1" width="48" height="20" text="Scroll" font="ui\small_ui" color="#FFFFFFFF" text_flags="no_focus_test">
	</widget>
	<widget name="main_menu/news/news_back_text" type="text" controller="1" width="120" height="20" text="%b-button Back" font="ui\small_ui" color="#FFFFFFFF" text_flags="no_focus_test">
	</widget>
	<widget name="main_menu/news/x_butn_news" width="16" height="20">
	</widget>
	<widget name="main_menu/news/b_butn_news_back" width="16" height="20">
	</widget>
	<widget name="main_menu/news/news_hint" type="text" controller="1" width="60" height="20" text="%x-button NEWS" font="ui\small_ui" color="#FFCCCCCC" text_flags="no_focus_test">
	</widget>
</menus>
