# a replay's buttons on the screen, for the overlay to press (host_touch.c;
# touch_input.c, port/linux/game/network_replay_playback.c)
host_touch_targets
# the phone's GPU family, for the GL ES renderer's fixes (host_render_policy.c; guest_render_policy.c)
